dist/
build/
__pycache__/
*.egg-info/
*.pyc
logs/

# IDE / editor
.idea/
.vscode/

# Local agent/tooling config — never publish
# Note `.claude/*` and not `.claude/` — git cannot re-include anything inside an
# excluded *directory*, so the directory must stay traversable for the negation
# below to take effect.
.claude/*
# ...except shared skills, which are team tooling rather than local config. The
# qa-agent skill drives agent_qa/ and is useless if it lives on one machine.
!.claude/skills/

# Environment / secrets
.env
*.env

# Generated at build time from docs/ (canonical source) — never commit
src/hiveq/docs/llms.txt
src/hiveq/docs/data_driver/llms.txt
